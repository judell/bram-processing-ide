<App
  name="Processing IDE"
  scrollWholePage="false"
  var.runDoc=""
  var.errors="{[]}"
  var.code=""
  var.current="intro"
  var.loadSeq="{0}">
  <AppHeader>
    <property name="titleTemplate">
      <HStack gap="$space-4" verticalAlignment="center">
        <Text variant="strong" value="Explore Processing" />
        <Select
          width="12rem"
          initialValue="{current}"
          onDidChange="(name) => { if (name && name !== current) { current = name; loadSeq++; } }">
          <Items data="{sketchList.value}">
            <Option value="{$item}" label="{$item}" />
          </Items>
        </Select>
        <Button
          label="New sketch"
          variant="outlined"
          size="sm"
          tooltip="Opens Bram with a request for a new sketch; press Enter there to send it"
          onClick="stageNewSketch()" />
        <HStack when="{errors.length > 0}" cursor="pointer" onClick="errorDialog.open()">
          <Text
            fontSize="$fontSize-sm"
            color="$color-danger-600"
            maxWidth="50vw"
            maxLines="1"
            overflowMode="ellipsis"
            tooltip="Click to see the full error"
            value="{(errors[0].line ? 'line ' + errors[0].line + ': ' : '') + errors[0].message + (errors.length > 1 ? ' (+' + (errors.length - 1) + ' more)' : '')}" />
        </HStack>
      </HStack>
    </property>
    <property name="profileMenuTemplate">
      <Text when="{!!syncStatus.value}" fontSize="$fontSize-sm" color="$textColor-secondary" value="{syncStatus.value}" />
    </property>
  </AppHeader>
  <ModalDialog id="errorDialog" title="Sketch errors">
    <Items data="{errors}">
      <Text preserveLinebreaks="true" value="{($item.line ? 'line ' + $item.line + ': ' : '') + $item.message}" />
    </Items>
  </ModalDialog>
  <DataSource
    id="source"
    url="sketches/{current}.js?v={loadSeq}"
    dataType="text"
    onLoaded="(text) => { noteSketch(current, text); editor.setValue(text); code = text; errors = []; runDoc = buildDoc(text); }" />
  <PushSource id="syncStatus" initial="" subscribe="{window.subscribeSyncStatus}" />
  <PushSource id="sketchList" initial="{['intro']}" subscribe="{window.subscribeSketchList}" />
  <PushSource id="pushed" subscribe="{window.subscribeSketchCode}" />
  <ChangeListener
    listenTo="{pushed.value}"
    onDidChange="() => { if (pushed.value && pushed.value.name === current) editor.setValue(pushed.value.code); }" />
  <MessageListener
    onMessageReceived="(msg) => { if (msg && msg.source === 'sketch') errors = errors.concat([msg]); }" />
  <HSplitter height="100%">
    <IFrame srcdoc="{runDoc}" title="sketch" width="100%" height="100%" />
    <VStack height="100%" overflowY="auto">
      <HStack gap="$space-1">
        <Text
          preserveLinebreaks="true"
          textAlign="end"
          minWidth="2.5em"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          lineHeight="1.5em"
          paddingTop="$space-2"
          marginTop="1px"
          value="{lineNumbers(code)}" />
        <Theme fontSize-TextArea="$fontSize-xs">
          <TextArea
            id="editor"
            width="*"
            autoSize="true"
            minRows="40"
            spellCheck="false"
            autoCorrect="false"
            onDidChange="(value) => { code = value; saveSketch(current, value); errors = []; runDoc = buildDoc(value); }" />
        </Theme>
      </HStack>
    </VStack>
  </HSplitter>
</App>
